<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 接続性チェック（DNS・HTTP）とネットワーク状態の取得 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- データ網の種類・回線の登録状態（実行時に利用者が許可。未許可でも動作し、該当項目は「取得不可」） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 画面消灯中も監視を続けるためのフォアグラウンドサービスと、チェック中だけの短いウェイクロック -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 再起動後の状態確認 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 電池の最適化から除外するよう、システムのダイアログで利用者に依頼する（Play では配布しない） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 設定ガイドで「自動同期」「Bluetooth」「NFC」の状態を読むため（読むだけで変更はしない） -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.NFC" />
    <!--
      第 3 段階。どちらも通常のアプリには付かず、利用者が PC から ADB で付けたときだけ使える（付けなければその機能が動かないだけ）。
      WRITE_SECURE_SETTINGS: 自動切り替え（F-42）でバッテリーセーバー（global low_power）と Doze（global device_idle_constants）だけを変える
      PACKAGE_USAGE_STATS: アプリ別の通信量（F-35）を読む（使用状況へのアクセス。読むだけ）
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!--
      第 4 段階。WRITE_SETTINGS（システム設定の変更）: 時間帯スケジュール（F-37）でテザリングを止める・再開する。
      Android 10 では、キャリアの確認が要らない端末なら、この許可でテザリングを切り替えられる。
      利用者が設定画面（特別なアプリアクセス）か ADB で許可したときだけ使う
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!--
      usesCleartextTraffic: 到達確認の既定 URL（generate_204）は通信量を最小にするため http を使う。
      targetSdk 28 以降は平文 HTTP が既定で禁止されるため明示的に許可する。
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="@string/title_guide"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="@string/title_apps"
            android:parentActivityName=".GuideActivity" />
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/title_diagnostics"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ExperimentActivity"
            android:exported="false"
            android:label="@string/title_experiment"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:label="@string/title_report"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".PlacementActivity"
            android:exported="false"
            android:label="@string/title_placement"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".TrafficActivity"
            android:exported="false"
            android:label="@string/title_traffic"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ClientGuideActivity"
            android:exported="false"
            android:label="@string/title_client_guide"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AnalysisActivity"
            android:exported="false"
            android:label="@string/title_analysis"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".MonitorService"
            android:exported="false" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED / MY_PACKAGE_REPLACED は保護ブロードキャスト。QUICKBOOT_POWERON は一部メーカー用 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          起動時のテザリング ON（v0.7.0）。画面ロックの解除前（Direct Boot）にも届くよう directBootAware にする。
          LOCKED_BOOT_COMPLETED / BOOT_COMPLETED は保護ブロードキャスト（OS だけが送れる）
        -->
        <receiver
            android:name=".BootTetherReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- 起動時のテザリング ON のやり直し・確認（このアプリのアラームだけが送る） -->
        <receiver
            android:name=".BootTetherRetryReceiver"
            android:directBootAware="true"
            android:exported="false" />
    </application>
</manifest>
